# ==========================================
# Frontend (React / Vite / Node)
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
node_modules/
dist/
dist-ssr/
*.local

# ==========================================
# Backend (Python / Flask / Machine Learning)
# ==========================================
__pycache__/
backend/__pycache__/
backend/*/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
backend/venv/
backend/.venv/
.env

# ==========================================
# Operating System & Editor Artifacts
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
desktop.ini

# ==========================================
# ML Model & Dataset Preservation Rule
# ==========================================
# Ensures your trained brain and dataset are NEVER ignored
!backend/app/ml/*.pkl
!backend/app/ml/*.csv